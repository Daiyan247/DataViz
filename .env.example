# ── Backend (server/main.py — FastAPI + Ollama) ─────────────────────────────
# The local model that interprets chart requests. Pull it once with:
#   ollama pull qwen2.5:7b
# Strong at instruction-following and structured output. Being bilingual it can
# drift into Chinese on the free-form analysis paragraph; main.py catches that and
# retries. llama3.1:8b is the English-primary swap; llama3.2 (2 GB) the light one.
OLLAMA_MODEL=qwen2.5:7b

# Where Ollama is listening (default is fine for a local install).
OLLAMA_HOST=http://localhost:11434

# Context window for the requests that carry the chart guide. The guide is ~4k
# tokens, so Ollama's 4096 default leaves no room for column profiles and would
# silently truncate it. Lower this only if you're short on memory.
OLLAMA_NUM_CTX=8192

# Context window for /api/analyse specifically. It sends only ONE chart-type
# section (not the whole guide), so its real prompt runs smaller than the other
# endpoints' — this doesn't need OLLAMA_NUM_CTX's size. Ollama's own guidance is to
# size num_ctx to the real prompt rather than the largest you might ever need
# (docs.ollama.com/faq). 6144 was chosen by MEASURING this app's worst realistic
# case (a 30-point line series) at ~4,573 prompt tokens via Ollama's own
# prompt_eval_count — a first attempt at 4096 was too tight and silently truncated
# the model's JSON mid-generation. Doubled automatically when an image is attached
# (vision tokens need far more room). Re-measure before lowering this further.
OLLAMA_ANALYSE_NUM_CTX=6144

# How long Ollama keeps a model loaded after a request, in its own duration syntax
# ("30m", "1h", "-1" for indefinitely). Ollama's server default is 5 minutes; below
# that, an interactive session that calls this backend repeatedly pays the full
# model-load cost again on the next chart. Raise this (or set -1) if you're doing a
# working session of several charts in a row; lower it if you're short on RAM/VRAM
# between uses. (docs.ollama.com/faq, "keep a model loaded in memory")
OLLAMA_KEEP_ALIVE=30m

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Where the browser sends chart requests. Leave blank to use the Vite dev proxy
# (recommended for local dev — requests to /api are forwarded to the backend on
# port 8000). Set it to the backend's full URL for a deployed setup.
VITE_API_URL=
