{
  "name": "dataviz-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drop in a CSV or JSON file, describe a chart in plain words, filter, and visualize.",
  "scripts": {
    "dev": "vite",
    "api": "uvicorn server.main:app --reload --port 8000",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.4.1",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-vega": "^7.6.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "us-atlas": "^3.0.1",
    "vega": "^5.30.0",
    "vega-lite": "^5.21.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
